import io

# .env నుండి API కీ లోడ్ చేయడం
load_dotenv()

# పేజీ డిజైన్ (Railway Station Voice Studio Theme)
st.set_page_config(
    page_title="రైల్వే స్టేషన్ AI వాయిస్ స్టూడియో",
    page_icon="🚂",
    layout="centered"
)

# స్టైలింగ్ కోసం కస్టమ్ CSS
st.markdown("""
    <style>
    .main { background-color: #0b0f19; color: #ffffff; }
    .stButton>button { width: 100%; background-color: #2563eb; color: white; border-radius: 12px; font-weight: bold; height: 3em; }
    .stButton>button:hover { background-color: #1d4ed8; }
    </style>
""", unsafe_allow_html=True)

st.markdown("<h1 style='text-align: center; color: #3b82f6;'>🚂 రైల్వే స్టేషన్ & PDF AI వాయిస్ స్టూడియో</h1>", unsafe_allow_html=True)
st.markdown("<p style='text-align: center; color: #94a3b8;'>ఏదైనా PDF బుక్ లేదా టెక్స్ట్ ఇవ్వండి, రైల్వే అనౌన్స్‌మెంట్ స్టైల్‌లో AI వాయిస్ ఓవర్ పొందండి!</p>", unsafe_allow_html=True)

# ElevenLabs క్లైంట్ సెటప్
api_key = os.getenv("ELEVENLABS_API_KEY", "YOUR_ACTUAL_API_KEY_HERE")
elevenlabs = ElevenLabs(api_key=api_key)

# 10 విభిన్న వాయిస్ IDs మ్యాపింగ్ (రైల్వే అనౌన్సర్లు / వాయిస్ స్టైల్స్)
VOICE_MAP = {
    "రైల్వే అనౌన్సర్ (Male - George)": "JBFqnCBsd6RMkjVDRZzb",
    "ప్రొఫెషనల్ న్యూస్ (Adam)": "21m00Tcm4TlvDq8ikWAM",
    "ఎనర్జిటిక్ (Dom)": "AZnzlk1XvdvUeBnXmlld",
    "గంభీరమైన గొంతు (Deep Male)": "EXAVITQu4vr4xnSDxMaL",
    "స్టోరీ టెల్లర్ (Josh)": "TxGEqnHWrfWFTfGW9XjX",
    "మృదువైన స్త్రీ గొంతు (Rachel)": "EXAVITQu4vr4xnSDxMaL",
    "కార్పొరేట్ వాయిస్ (Elli)": "MF3mGyEYCl7XYWbV9V6O",
    "ఫ్రెండ్లీ వాయిస్ (Dom Female)": "AZnzlk1XvdvUeBnXmlld",
    "నవలా కథకి (Dorothy)": "ThT5KcBeYPX3keUQqHPh",
    "వైబ్రెంట్ వాయిస్ (Matilda)": "pFZP5JQG7SXQjIHCAL4B"
}

# యూజర్ ఇన్‌పుట్ సెక్షన్
uploaded_file = st.file_uploader("📂 PDF ఫైల్ అప్‌లోడ్ చేయండి (రైల్వే బుక్ / టెక్స్ట్)", type=["pdf"])

text_content = ""
if uploaded_file is not None:
    try:
        import pypdf
        reader = pypdf.PdfReader(uploaded_file)
        for page in reader.pages:
            text_content += page.extract_text() + "\n"
        st.success("✅ PDF ఫైల్ విజయవంతంగా రీడ్ చేయబడింది!")
    except Exception as e:
        st.error(f"PDF రీడింగ్ లోపం: {e}")

# టెక్స్ట్ బాక్స్
user_text = st.text_area("✍️ లేదా మీ టెక్స్ట్ ఇక్కడ టైప్ చేయండి / పేస్ట్ చేయండి:", value=text_content, height=150)

# లాంగ్వేజ్ మరియు వాయిస్ సెలెక్షన్
col1, col2 = st.columns(2)
with col1:
    target_lang = st.selectbox("భాష (Language):", ["తెలుగు (Telugu)", "हिंदी (Hindi)", "English (US)", "தமிழ் (Tamil)", "ಕನ್ನಡ (Kannada)"])

with col2:
    selected_voice_name = st.selectbox("వాయిస్ స్టైల్ (Voice):", list(VOICE_MAP.keys()))

# జనరేట్ బటన్
if st.button("🎙️ వాయిస్ ఓవర్ ఆడియోను జనరేట్ చేయండి"):
    if not user_text.strip():
        st.warning("⚠️ దయచేసి టెక్స్ట్ ఎంటర్ చేయండి లేదా PDF అప్‌లోడ్ చేయండి!")
    else:
        with st.spinner("⏳ రైల్వే AI వాయిస్ ప్రాసెస్ అవుతోంది... దయచేసి వేచి ఉండండి..."):
            try:
                voice_id = VOICE_MAP[selected_voice_name]
                
                # ElevenLabs API కాల్
                audio_stream = elevenlabs.text_to_speech.convert(
                    text=user_text[:2500],  # పెద్ద టెక్స్ట్ మొదటి భాగాన్ని ప్రాసెస్ చేస్తుంది
                    voice_id=voice_id,
                    model_id="eleven_multilingual_v2",
                    output_format="mp3_44100_128",
                )
                
                audio_bytes = io.BytesIO()
                for chunk in audio_stream:
                    audio_bytes.write(chunk)
                audio_bytes.seek(0)
                
                st.success("🎉 ఆడియో విజయవంతంగా తయారైంది!")
                st.audio(audio_bytes, format="audio/mp3")
                
            except Exception as e:
                st.error(f"❌ లోపం సంభవించింది: {e}")
